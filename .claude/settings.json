{
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.dev)",
      "Read(/.env.test)",
      "Read(/.env.prod)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.dev",
        "./.env.test",
        "./.env.prod"
      ]
    }
  }
}
